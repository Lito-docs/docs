  "seo": {
    "ogImage": "/og-image.png",
    "twitterHandle": "@litodocs",
    "defaultAuthor": "Lito Team",
    "defaultKeywords": ["documentation", "lito", "astro", "markdown"],
    "enableJsonLd": true,
    "organizationName": "Lito",
    "articleType": "TechArticle",
    "autoCanonical": true,
    "enableBreadcrumbs": true
  },
  "i18n": {
    "defaultLocale": "en",
    "locales": ["en", "es", "fr", "de"],
    "routing": {
      "prefixDefaultLocale": false
    },
    "translations": {
      "es": {
        "search.placeholder": "Buscar en la documentación..."
      },
      "fr": {
        "search.placeholder": "Rechercher dans la documentation..."
      }
    }
  },
  "integrations": {
    "editPage": {
      "enabled": true,
      "pattern": "https://github.com/Lito-docs/docs/edit/main/{path}"
    },
    "lastUpdated": {
      "enabled": true,
      "format": "long"
    },
    "feedback": {
      "enabled": true
    },
    "copyPage": {
      "enabled": true
    }
  },
  "assets": {
    "images": "_images",
    "css": "_css",
    "static": "_assets"
  },
  "landing": {
    "type": "custom",
    "source": "_landing",
    "injectNav": true,
    "injectFooter": true
  },
  "versioning": {
    "enabled": true,
    "defaultVersion": "latest",
    "versions": [
      {
        "id": "latest",
        "label": "Latest (v3)",
        "path": "latest"
      },
      {
        "id": "v2",
        "label": "v2.x",
        "path": "v2"
      },
      {
        "id": "v1",
        "label": "v1.x",
        "path": "v1",
        "deprecated": true
      }
    ],
    "versionBanner": {
      "enabled": true,
      "message": "You are viewing documentation for {version}. See the {latest} version."
    }
  },
  "footer": {
    "layout": "full",
    "tagline": "Beautiful documentation sites from Markdown. Fast, simple, and open-source.",
    "copyright": "© {year} Lito. All rights reserved.",
    "showBranding": true,
    "showVersion": true,
    "socials": {
      "github": "https://github.com/Lito-docs",
      "twitter": "https://twitter.com/litodocs",
      "discord": "https://discord.gg/litodocs"
    },
    "links": [
      {
        "title": "Product",
        "items": [
          { "label": "Documentation", "href": "/introduction" },
          { "label": "Components", "href": "/reference/components" },
          { "label": "Changelog", "href": "/changelog" }
        ]
      },
      {
        "title": "Resources",
        "items": [
          { "label": "Getting Started", "href": "/getting-started/installation" },
          { "label": "CLI Reference", "href": "/reference/cli-commands" },
          { "label": "Configuration", "href": "/reference/configuration" }
        ]
      },
      {
        "title": "Community",
        "items": [
          { "label": "GitHub", "href": "https://github.com/Lito-docs", "external": true },
          { "label": "Discord", "href": "https://discord.gg/litodocs", "external": true },
          { "label": "Twitter", "href": "https://twitter.com/litodocs", "external": true }
        ]
      }
    ],
    "bottomLinks": [
      { "label": "Privacy Policy", "href": "/privacy" },
      { "label": "Terms of Service", "href": "/terms" }
    ]
  }
}
